# Plantilla de variables de entorno del backend.
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.

# Entorno: development | production | test
NODE_ENV=development

# Puerto de la API
PORT=4000

# MongoDB Atlas (producción/desarrollo remoto) o local (desarrollo):
#   Local con transacciones: mongod --dbpath .mongo-data --replSet rs0
#   y posteriormente: node scripts/init-replica.js
MONGO_URI=mongodb://127.0.0.1:27017/erp?replicaSet=rs0

# Secretos: cadenas largas y aleatorias; distintas entre sí; ≥32 caracteres en producción
JWT_SECRET=cambie-este-valor-largo-aleatorio
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=cambie-este-otro-valor-largo-aleatorio
REFRESH_TOKEN_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma)
CLIENT_URL=http://localhost:8081,http://localhost:19006

# Bloqueo de cuenta por intentos fallidos de login
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
