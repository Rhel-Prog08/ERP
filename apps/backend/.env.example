# Plantilla de variables de entorno del backend.
# Copia a .env dentro de apps/backend para desarrollo local.
# Nunca guardes credenciales reales en este archivo ni subas archivos .env.

# Entorno: development | test | production
NODE_ENV=development

# Puerto local de la API; Render proporciona PORT automáticamente.
PORT=4000

# MongoDB local con replica set para transacciones:
# mongod --dbpath .mongo-data --port 27017 --bind_ip 127.0.0.1 --replSet rs0
# node scripts/init-replica.js
MONGO_URI=mongodb://127.0.0.1:27017/erp?replicaSet=rs0

# Marcadores solo para desarrollo. En producción configura dos secretos
# aleatorios distintos de al menos 32 caracteres en Render Environment.
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-only-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Orígenes web locales; en producción usa el origen HTTPS exacto del frontend.
CLIENT_URL=http://localhost:8081,http://localhost:19006

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Atlas: define MONGO_URI como variable privada de Render usando la URI
# mongodb+srv:// suministrada por Atlas. No copies credenciales reales aquí.
