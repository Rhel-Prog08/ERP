# Variables de entorno del frontend Expo
# Copiar a .env y ajustar valores según el entorno.

# URL base del backend. Para builds preview/production debe ser HTTPS en Render.
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# El código permite localhost solo en desarrollo y exige una URL configurada
# para preview y production.
EXPO_PUBLIC_APP_ENV=development
