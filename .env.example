# Plantilla local del backend ERP.
# Copia a apps/backend/.env para desarrollo local.
# No pegues credenciales reales ni subas archivos .env al repositorio.

# development | test | production
NODE_ENV=development

# El backend usa process.env.PORT; Render lo proporciona automáticamente.
# 4000 es el fallback local. No es necesario fijar PORT en Render.
PORT=4000

# MongoDB local con replica set requerido para las transacciones:
# mongod --dbpath .mongo-data --port 27017 --bind_ip 127.0.0.1 --replSet rs0
# node apps/backend/scripts/init-replica.js
MONGO_URI=mongodb://127.0.0.1:27017/erp?replicaSet=rs0

# Valores deliberadamente inválidos/débiles para producción.
# En Render configura dos secretos aleatorios DISTINTOS de al menos 32 caracteres.
# Generador local: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=dev-only-refresh-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Orígenes web locales permitidos por CORS, separados por coma.
# En Render reemplázalos por el origen HTTPS exacto del frontend desplegado.
CLIENT_URL=http://localhost:8081,http://localhost:19006

MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Para Atlas, usa la cadena SRV en MONGO_URI como variable privada de Render:
# mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER_HOST>/erp?retryWrites=true&w=majority
# No pongas la URI de Atlas, usuario ni contraseña en el frontend o Git.
# La URL pública EXPO_PUBLIC_API_URL pertenece a apps/frontend/.env.example.
