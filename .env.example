# ============================================================
# ERP PyMES — Variables de entorno (plantilla)
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto del servidor API
PORT=4000

# Cadena de conexión a MongoDB Atlas (backend ÚNICO que la conoce)
# Ejemplo: mongodb+srv://usuario:clave@cluster0.xxxxx.mongodb.net/erp?retryWrites=true&w=majority
# Desarrollo local (replica set para transacciones):
#   mongod --dbpath .mongo-data --replSet rs0 && node apps/backend/scripts/init-replica.js
MONGO_URI=mongodb://127.0.0.1:27017/erp?replicaSet=rs0

# Secreto JWT para access tokens (cadena larga y aleatoria)
JWT_SECRET=cambie-este-valor-largo-aleatorio

# Duración del access token (ej: 15m, 1h)
JWT_EXPIRES_IN=15m

# Secreto para refresh tokens (distinto de JWT_SECRET)
REFRESH_TOKEN_SECRET=cambie-este-otro-valor-largo-aleatorio

# Duración del refresh token (ej: 7d)
REFRESH_TOKEN_EXPIRES_IN=7d

# Origen permitido para CORS (frontend web, separados por coma)
CLIENT_URL=http://localhost:8081,http://localhost:19006

# Número máximo de intentos de login antes del bloqueo temporal
MAX_LOGIN_ATTEMPTS=5

# Duración del bloqueo tras intentos fallidos (minutos)
LOGIN_LOCKOUT_MINUTES=15
